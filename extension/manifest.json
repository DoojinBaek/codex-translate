{
  "manifest_version": 3,
  "name": "Codex Translate",
  "version": "0.4.1",
  "description": "Translate the current page in place using your local Codex (ChatGPT) login.",
  "action": {
    "default_title": "Codex Translate (Alt+A)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "contextMenus"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "번역 / 원문 전환"
    }
  },
  "key": ""
}
